# Copy to `.env` and fill in. Never commit `.env`: it holds your keys.
# Every setting is explained in docs/configuration.md.

# --- Language model -----------------------------------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint. One block per model: a "profile" is a
# group of <NAME>_ENDPOINT / _MODEL / _API_KEY / _LABEL variables. The UI lists every
# profile and marks the ones the endpoint currently serves. The model should accept images.
#
# Radiographs are sent to this endpoint. Use a local or institutional server for real
# patient data, not a public cloud API.
ACTIVE_PROFILE=local_vision

# A local model through Ollama (no key needed)
LOCAL_VISION_ENDPOINT=http://localhost:11434/v1/chat/completions
LOCAL_VISION_MODEL=qwen2.5vl:7b
LOCAL_VISION_LABEL=Qwen2.5-VL 7B (lokal)

# A vLLM, LiteLLM or other OpenAI-compatible server
# MYSERVER_ENDPOINT=https://my-server:8000/v1/chat/completions
# MYSERVER_MODEL=<model id as the server lists it under /v1/models>
# MYSERVER_API_KEY=<key>
# MYSERVER_LABEL=<name shown in the model dropdown>

# TLS certificate checks for the model and morphometry endpoints (default true).
# Set to false for a server with a self-signed certificate.
# VERIFY_SSL=false

# --- Guideline search ------------------------------------------------------------------------
# The agent's evidence base. Every reference range in a report comes from here.
# Choose one; without any, measurements are reported but never interpreted.

# Local Markdown/text files. A small demo corpus ships with the repo (not for clinical use).
GUIDELINES_DIR=guidelines/example_corpus

# Any MCP server (Streamable HTTP) with a search tool
# GUIDELINES_MCP_URL=https://my-rag-server/mcp
# GUIDELINES_MCP_TOKEN=<bearer token>

# A plain JSON endpoint, called as POST {"query": ..., "top_k": ...}
# GUIDELINES_HTTP_URL=https://my-rag-server/search
# GUIDELINES_HTTP_TOKEN=<bearer token>

# Language of your corpus: de | en | mixed
GUIDELINES_LANGUAGE=de

# --- Morphometry service ------------------------------------------------------------------------
# Landmark matching + measurements on a GPU. Reference implementation:
# https://github.com/TruhnLab/RadiographLandmarkMatching (docker/)
MORPHO_URL=https://localhost
MORPHO_API_KEY=<the API_KEY you set for the service>
# References matched per image: 10 takes about 15 s on a GPU, -1 uses all of them.
MORPHO_NUM_REFERENCES=10
# The reference deployment serves a self-signed certificate.
MORPHO_VERIFY_SSL=false
