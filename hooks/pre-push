#!/bin/sh
# Push guard for the project page. Install: cp hooks/pre-push .git/hooks/pre-push
# This folder only ever pushes its gh-pages branch, so it can never touch the code on main.
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" != "refs/heads/gh-pages" ]; then
    echo "pre-push: refusing to push $local_ref to $remote_ref. Only gh-pages may be pushed from here." >&2
    status=1
  fi
done
exit $status
